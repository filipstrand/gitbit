{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (playground)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--new-window",
        "--folder-uri",
        "file:///Users/filipstrand/Desktop/gitbit-playground"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "npm: package"
    }
  ]
}
